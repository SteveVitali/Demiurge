# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...       # Monthly Starter plan
STRIPE_STARTER_ANNUAL_PRICE_ID=price_... # Annual Starter plan
STRIPE_PRO_PRICE_ID=price_...           # Monthly Pro plan
STRIPE_PRO_ANNUAL_PRICE_ID=price_...    # Annual Pro plan
STRIPE_TEAM_PRICE_ID=price_...          # Monthly Team plan (per-seat)
STRIPE_TEAM_ANNUAL_PRICE_ID=price_...   # Annual Team plan (per-seat)

# Keygen
KEYGEN_ACCOUNT_ID=...
KEYGEN_PRODUCT_TOKEN=...                # Admin-level product token
KEYGEN_PRODUCT_ID=...
KEYGEN_TRIAL_POLICY_ID=...              # 14-day trial policy
KEYGEN_STARTER_POLICY_ID=...            # Starter plan policy
KEYGEN_PRO_POLICY_ID=...                # Pro plan policy
KEYGEN_TEAM_POLICY_ID=...               # Team plan policy

# GitHub (for release fetching)
GITHUB_TOKEN=ghp_...                    # Optional, increases API rate limit for release fetching

# Site
NEXT_PUBLIC_APP_URL=https://demiurge.dev
NEXT_PUBLIC_GITHUB_REPO=SteveVitali/Demiurge
DESKTOP_DEEP_LINK_SCHEME=demiurge       # demiurge:// deep link

# Stripe public price IDs (for client-side pricing table)
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PRO_ANNUAL_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_TEAM_ANNUAL_PRICE_ID=price_...

# PostHog (telemetry / analytics — free up to 1M events/mo)
NEXT_PUBLIC_POSTHOG_KEY=phc_...              # PostHog project API key (optional — no tracking if unset)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com  # PostHog ingest host (default: US cloud)

# Resend (transactional email — free up to 3k/mo)
RESEND_API_KEY=re_...                        # Resend API key (optional — emails logged to console if unset)
