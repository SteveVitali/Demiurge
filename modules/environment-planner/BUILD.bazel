load("@rules_scala//scala:scala.bzl", "scala_junit_test", "scala_library")

# Phase 3: Environment planning module — manifest + inspection → RuntimePlan
scala_library(
    name = "environment-planner",
    srcs = glob(["src/main/scala/**/*.scala"], allow_empty = True),
    visibility = ["//visibility:public"],
    deps = [
        "//modules/core-model",
        "//modules/manifest",
    ],
)

scala_junit_test(
    name = "environment-planner-tests",
    srcs = glob(["src/test/scala/**/*.scala"], allow_empty = True),
    suffixes = ["Suite"],
    deps = [
        ":environment-planner",
        "//modules/core-model",
        "//modules/manifest",
        "@maven//:org_yaml_snakeyaml",
        "@maven//:org_scalameta_munit_2_13",
        "@maven//:org_scalameta_munit_diff_2_13",
    ],
)
