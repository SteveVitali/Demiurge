load("@rules_scala//scala:scala.bzl", "scala_junit_test", "scala_library")

# Phase 3: Repo inspection module — deterministic filesystem scanning
scala_library(
    name = "repo-inspector",
    srcs = glob(["src/main/scala/**/*.scala"], allow_empty = True),
    visibility = ["//visibility:public"],
    deps = [
        "//modules/core-model",
        "//modules/manifest",
        "@maven//:io_circe_circe_core_2_13",
        "@maven//:io_circe_circe_parser_2_13",
        "@maven//:org_typelevel_cats_core_2_13",
        "@maven//:org_typelevel_cats_kernel_2_13",
        "@maven//:org_yaml_snakeyaml",
    ],
)

scala_junit_test(
    name = "repo-inspector-tests",
    srcs = glob(["src/test/scala/**/*.scala"], allow_empty = True),
    suffixes = ["Suite"],
    deps = [
        ":repo-inspector",
        "//modules/core-model",
        "//modules/manifest",
        "@maven//:org_scalameta_munit_2_13",
        "@maven//:org_scalameta_munit_diff_2_13",
    ],
)
