load("@rules_scala//scala:scala.bzl", "scala_binary", "scala_junit_test", "scala_library")

# Phase 7: CLI module — command parsing, execution, output formatting
scala_library(
    name = "cli",
    srcs = glob(["src/main/scala/**/*.scala"], allow_empty = True),
    visibility = ["//visibility:public"],
    deps = [
        "//modules/core-model",
        "//modules/persistence",
        "@maven//:io_circe_circe_core_2_13",
        "@maven//:io_circe_circe_generic_2_13",
        "@maven//:io_circe_circe_parser_2_13",
        "@maven//:org_typelevel_cats_core_2_13",
        "@maven//:org_typelevel_cats_kernel_2_13",
        "@maven//:com_chuusai_shapeless_2_13",
        "@maven//:org_xerial_sqlite_jdbc",
    ],
)

scala_binary(
    name = "lastmile",
    main_class = "lastmile.cli.Main",
    visibility = ["//visibility:public"],
    deps = [":cli"],
)

scala_junit_test(
    name = "cli-tests",
    srcs = glob(["src/test/scala/**/*.scala"], allow_empty = True),
    suffixes = ["Suite"],
    deps = [
        ":cli",
        "//modules/core-model",
        "//modules/persistence",
        "@maven//:io_circe_circe_core_2_13",
        "@maven//:io_circe_circe_generic_2_13",
        "@maven//:io_circe_circe_parser_2_13",
        "@maven//:org_typelevel_cats_core_2_13",
        "@maven//:org_typelevel_cats_kernel_2_13",
        "@maven//:com_chuusai_shapeless_2_13",
        "@maven//:org_xerial_sqlite_jdbc",
        "@maven//:org_scalameta_munit_2_13",
        "@maven//:org_scalameta_munit_diff_2_13",
    ],
)
