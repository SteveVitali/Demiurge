load("@rules_scala//scala:scala.bzl", "scala_junit_test", "scala_library")

# Phase 3: Runtime supervision module — service startup, readiness, fixtures, teardown
scala_library(
    name = "runtime-supervisor",
    srcs = glob(["src/main/scala/**/*.scala"], allow_empty = True),
    visibility = ["//visibility:public"],
    deps = [
        "//modules/core-model",
        "//modules/manifest",
    ],
)

scala_junit_test(
    name = "runtime-supervisor-tests",
    srcs = glob(["src/test/scala/**/*.scala"], allow_empty = True),
    suffixes = ["Suite"],
    deps = [
        ":runtime-supervisor",
        "//modules/core-model",
        "//modules/manifest",
        "@maven//:org_scalameta_munit_2_13",
        "@maven//:org_scalameta_munit_diff_2_13",
    ],
)
