module(
    name = "demiurge",
    version = "0.1.0",
)

# --- rules_scala ---
bazel_dep(name = "rules_scala", version = "7.2.4")

scala_config = use_extension(
    "@rules_scala//scala/extensions:config.bzl",
    "scala_config",
)
scala_config.settings(scala_version = "2.13.18")

scala_deps = use_extension(
    "@rules_scala//scala/extensions:deps.bzl",
    "scala_deps",
)
scala_deps.scala()
scala_deps.scalatest()
scala_deps.junit()

# --- rules_jvm_external for Maven deps ---
bazel_dep(name = "rules_jvm_external", version = "6.7")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "io.circe:circe-core_2.13:0.14.10",
        "io.circe:circe-generic_2.13:0.14.10",
        "io.circe:circe-parser_2.13:0.14.10",
        "com.chuusai:shapeless_2.13:2.3.12",
        "org.xerial:sqlite-jdbc:3.45.3.0",
        "org.scalameta:munit_2.13:1.0.3",
        "org.scalameta:munit-diff_2.13:1.0.3",
        "org.typelevel:cats-core_2.13:2.12.0",
        "org.typelevel:cats-kernel_2.13:2.12.0",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")
